{
  "name": "SwiftClaude",
  "dockerFile": "Dockerfile",

  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],

  "mounts": [
    /// Keep build products on a volume for performance and to separate host and guest build artifacts
    "type=volume,source=${localWorkspaceFolderBasename}-build,target=${containerWorkspaceFolder}/.build",
    "type=volume,source=claude-code-npm,target=/root/.npm"
  ],

  /// Install Claude Code, but only after creating the npm volume
  "postCreateCommand": {
    "Link Local Configuration": "rm -f /root/.claude.json && rm -rf /root/.claude && ln -s ${containerWorkspaceFolder}/.claude/code/claude.json /root/.claude.json && ln -s ${containerWorkspaceFolder}/.claude/code/claude /root/.claude"
  },

  "remoteEnv": {
    /// Useful for disambiguating devcontainers
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "swiftlang.swift-vscode"
      ],
      "settings": {
        "files.exclude": {
          /// Code coverage data
          "default.profraw": true
        }
      }
    }
  }
}
